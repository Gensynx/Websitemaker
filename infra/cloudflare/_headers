# Cloudflare Pages response headers for vassallodevelopments.com.
# Copied into the build output by build.sh; Pages reads it, never serves it.
# These are the headers GitHub Pages cannot send (snag list S-09, A-13).

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# The pages themselves: always rechecked, and "no-transform" so Cloudflare
# cannot inject anything into them (its Web Analytics beacon, Rocket Loader,
# email obfuscation). The pages' own security policy would block those anyway.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/configurator/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/privacy
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# Fingerprinted file names: safe to keep for a year.
/configurator/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Keep the workers.dev and pages.dev copies out of search results, so only the
# real domain is indexed.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
https://vassallo-developments.pages.dev/*
  X-Robots-Tag: noindex
https://:version.vassallo-developments.pages.dev/*
  X-Robots-Tag: noindex
